# ---------------------------------------------------------------------------
# M04 健康問卷模組 — 環境變數範本
#
# 用法：複製一份成 .env，再依你這台機器的實際設定填值。
#   cp .env.example .env
#
# .env 本身「不進版控」（見 .gitignore）。原因是 Mac / Windows / Fedora
# 三台開發機的 PostgreSQL 帳號密碼與連線設定大概率不同，共用一份會互相打架，
# 而且 DB 密碼不該進 GitHub。
# ---------------------------------------------------------------------------

# --- Django ---
# 產生方式：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 正式部署務必換成新的、且不要與開發環境共用。
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string

# 開發機填 True；正式部署一定要 False。
DJANGO_DEBUG=True

# DEBUG=False 時必填，以逗號分隔，例如：m04.mmh.org.tw,127.0.0.1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# CSRF 信任來源（含 scheme）。本機開發用預設值即可；正式部署改成
# 真實網域，例如：https://m04.mmh.org.tw
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1,http://localhost

# --- PostgreSQL ---
DATABASE_NAME=m04_questionnaire
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ---------------------------------------------------------------------------
# 各機器填法備註
#
# [macOS / Homebrew]
#   brew 的 postgresql@16 預設用 "trust" 本機認證（連線不需密碼），所以：
#     DATABASE_USER     = 你的 macOS 使用者名稱（例如 whoami 的輸出）
#     DATABASE_PASSWORD = 留空
#
#   ⚠️ 這只適用於本機開發。部署到院內伺服器時必須改用密碼認證
#      （修改 pg_hba.conf 的 trust -> scram-sha-256 並設定 DB 密碼），
#      否則等同於資料庫不設防。
#
# [Fedora]
#   預設為 ident/peer 認證，通常需要先建立與系統帳號同名的 DB user：
#     sudo -u postgres createuser --interactive
#
# [Windows]
#   PostgreSQL 安裝時會要求設定 postgres 使用者的密碼，把該密碼填進
#   DATABASE_PASSWORD，DATABASE_USER 通常為 postgres。
# ---------------------------------------------------------------------------

# =========================
# 金寶貝 API
# =========================

GOLDEN_BABY_API_URL=https://icare.docter.pro/back-end/app

# true = 使用模擬資料
# false = 使用正式金寶貝 API
GOLDEN_BABY_API_MOCK=true

# 正式 API 使用
GOLDEN_BABY_API_ACCOUNT=
GOLDEN_BABY_API_PASSWORD=